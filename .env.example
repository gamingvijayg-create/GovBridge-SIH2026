# Environment Variables Configuration Template
# Create a .env file locally and set your secret environment variables

# Groq Cloud API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas Connection URI
# In production (NODE_ENV=production or RENDER), MONGO_URI is strictly required; server will abort if missing.
# In local development, if left blank, the server safely falls back to mongodb-memory-server.
MONGO_URI=your_mongodb_atlas_connection_uri_here

# JWT Secret for Session Authentication
JWT_SECRET=govbridge_secret_2026_change_this_in_production

# Backend Server Port
PORT=5000

# OTP & Notification Provider
# Default: 'email' (primary verification method; sends 6-digit OTP to user's registered email)
# Other options:
#   - 'console': Development only. Prints OTP to terminal. Throws error if used in production.
#   - 'msg91': Optional SMS fallback (requires DLT approval).
SMS_PROVIDER=email

# Email SMTP Settings (Required when SMS_PROVIDER=email)
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account.
#   2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   3. Use host: smtp.gmail.com, port: 587 (or 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=GovBridge Security <no-reply@govbridge.gov.in>

# MSG91 SMS Provider (Optional; only used if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=your_msg91_sender_id_here
MSG91_DLT_ENTITY_ID=your_msg91_dlt_entity_id_here
